# ===================================================
#  VehicleIQ Environment Variables Example Configuration
# ===================================================

# ASP.NET Core Environment (Development, Staging, Production)
ASPNETCORE_ENVIRONMENT=Development

# SQL Server Database Connection String
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=VehicleIQDB;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True;

# JWT Authentication Configuration (Must be at least 32 characters in production)
Jwt__Key=VehicleIQ_SuperSecret_SigningKey_Min32Chars_2024!!
Jwt__Issuer=VehicleIQ.API
Jwt__Audience=VehicleIQ.React
Jwt__ExpiresInDays=7

# CORS Policy Allowed Origins (Comma separated for multiple origins)
Cors__AllowedOrigins__0=http://localhost:5173

# Listening Port Configuration
Urls=http://localhost:5109

# Google Gemini AI Copilot API Key (Get a free key at https://aistudio.google.com/apikey)
Gemini__ApiKey=YOUR_GEMINI_API_KEY
Gemini__Model=gemini-2.0-flash

